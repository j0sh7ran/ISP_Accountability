<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="Connectivity State Machine" id="state-machine">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000" vertex="1" parent="1">
          <mxGeometry x="380" y="40" width="20" height="20" as="geometry" />
        </mxCell>

        <mxCell id="online" value="ONLINE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="330" y="120" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="degraded" value="DEGRADED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="330" y="270" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="offline" value="OFFLINE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="330" y="420" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="recovering" value="RECOVERING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="600" y="270" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="start" target="online">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="degradation confirmed&#10;(threshold crossed)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="online" target="degraded">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="connectivity loss confirmed&#10;(threshold crossed)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="degraded" target="offline">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="recovered before&#10;offline threshold reached" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0;exitY=0.25;entryX=0;entryY=0.75;" edge="1" parent="1" source="degraded" target="online">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="260" y="285" />
              <mxPoint x="260" y="150" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="s4" value="first successful probe&#10;after outage" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="offline" target="recovering">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="s5" value="sustained success over&#10;confirmation window" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="recovering" target="online">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="s6" value="recovery check fails again" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.75;entryX=1;entryY=0.25;" edge="1" parent="1" source="recovering" target="offline">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="820" y="335" />
              <mxPoint x="820" y="455" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
