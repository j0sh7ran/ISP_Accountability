          <mxGeometry x="340" y="110" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="db" value="SQLite Database&#10;(WAL mode, single file)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;boundedLbl=1" vertex="1" parent="1">
